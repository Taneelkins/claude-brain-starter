#!/usr/bin/env python3
# PreToolUse hook: block starting a Studio playtest unless this chat holds a studio-* claude-lock. Fails open on any error.
import json, os, re, sys, time

def Main():
    d = json.load(sys.stdin)
    name = d.get("tool_name", "")
    inp = json.dumps(d.get("tool_input", {})).lower()
    if name.endswith("start_stop_play") or name.endswith("play_control"):
        if re.search(r'false|stop|"end"|pause', inp):
            return 0
    elif not name.endswith("run_in_play_mode"):
        return 0
    title = ""
    try:
        with open(d["transcript_path"], errors="ignore") as f:
            for line in f:
                m = re.search(r'"customTitle":"([^"]*)"', line)
                if m:
                    title = m.group(1)
    except Exception:
        return 0
    if not title:
        return 0
    held = os.path.expanduser("~/.claude-locks/held")
    now = time.time()
    for r in os.listdir(held) if os.path.isdir(held) else []:
        try:
            info = json.load(open(os.path.join(held, r, "info.json")))
        except Exception:
            continue
        if r.startswith("studio") and info.get("who") == title and now - info.get("beat", 0) <= info.get("ttl", 300):
            return 0
    sys.stderr.write('Blocked: take the lock first. Run: claude-lock take studio-test --who "%s" --why "<what>" --wait 540. Give it back after get_studio_state reads Edit.\n' % title)
    return 2

try:
    sys.exit(Main())
except Exception:
    sys.exit(0)
