#!/usr/bin/env python3
# Stop hook: when a chat's context passes a threshold, tell it to hand off to a fresh chat. Once per threshold. Fails open.
import json, os, sys

Steps = [300000, 450000, 600000]

def Main():
    d = json.load(sys.stdin)
    if d.get("stop_hook_active"):
        return 0
    used = 0
    with open(d["transcript_path"], errors="ignore") as f:
        for line in f:
            try:
                u = (json.loads(line).get("message") or {}).get("usage")
            except Exception:
                continue
            if u:
                used = u.get("input_tokens", 0) + u.get("cache_creation_input_tokens", 0) + u.get("cache_read_input_tokens", 0)
    hit = max([s for s in Steps if used >= s], default=0)
    if not hit:
        return 0
    folder = os.path.expanduser("~/.claude-locks/ctx")
    os.makedirs(folder, exist_ok=True)
    mark = os.path.join(folder, d.get("session_id", "x"))
    done = int(open(mark).read()) if os.path.exists(mark) else 0
    if done >= hit:
        return 0
    open(mark, "w").write(str(hit))
    reason = ("Context is about %dk tokens, which makes every turn expensive. Hand off at this stage break: finish only the edit in flight, "
              "update your report page, run /save and check it landed, write a continuation opener in your Work folder "
              "(what's built, what's open, pending picks, only the notes it must read, plus the Chain footer), then start the continuation chat "
              "yourself with the opener as its prompt (in the Claude app: a new session) and give the user its link in one line. "
              "If you can't start sessions here, copy the opener to the clipboard (pbcopy) and tell the user to paste it into a new chat. Don't start new work." % (used // 1000))
    print(json.dumps({"decision": "block", "reason": reason}))
    return 0

try:
    sys.exit(Main())
except Exception:
    sys.exit(0)
